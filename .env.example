# ─────────────────────────────────────────────────────────────
# Base de données
#   - Développement local sans installation : pglite:./storage/pgdata
#   - Production (Supabase PostgreSQL) :
#     postgresql://postgres.[PROJECT_REF]:[MOT_DE_PASSE]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# ─────────────────────────────────────────────────────────────
DATABASE_URL=pglite:./storage/pgdata

# URL publique du site sur Netlify (ex. https://ma-boutique.netlify.app)
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Identifiants Administrateur Initiaux (Optionnel en production)
# Si non renseignés, la page sécurisée /admin/setup permet de créer
# le compte propriétaire au premier lancement sur Netlify.
# ─────────────────────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Propriétaire

# ─────────────────────────────────────────────────────────────
# Notifications push (Web Push / VAPID) — générer avec : npm run vapid:generate
# VAPID_SUBJECT doit être une adresse mailto: ou une URL https: du propriétaire.
# ─────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─────────────────────────────────────────────────────────────
# Stockage des images
#   - local : fichiers dans ./storage/uploads (ou /tmp/uploads en serverless)
#   - s3    : tout service compatible S3 (Supabase Storage S3, Cloudflare R2, AWS S3…)
# ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Secret protégeant les tâches planifiées
CRON_SECRET=
